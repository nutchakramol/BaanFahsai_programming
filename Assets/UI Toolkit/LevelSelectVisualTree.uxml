                <ui:Image name="Lock" style="position: absolute; width: 134px; height: 187px; background-color: rgba(0, 0, 0, 0); background-image: url(&quot;project://database/Assets/Sprites/lock.png?fileID=-7670485267309540912&amp;guid=811b5b1a8d6fa3a4d9a7eac60c325778&amp;type=3#lock_0&quot;); top: 94px; left: 143px; display: none;"/>
                <ui:Image name="Crown" style="position: absolute; height: 100px; width: 100px; left: 163px; top: -47px; bottom: 360px; background-color: rgba(0, 0, 0, 0); background-image: url(&quot;project://database/Assets/Sprites/crown.png?fileID=-6981827254641702772&amp;guid=520dbdda35200f24c962e31567adb29c&amp;type=3#cloud_0&quot;);"/>
                <ui:Image name="Star2" style="position: absolute; width: 75px; height: 69px; background-color: rgba(0, 0, 0, 0); background-image: url(&quot;project://database/Assets/Sprites/download.png?fileID=3573036208370857778&amp;guid=97331bdcf8b306b49a058bb44ff5ffe7&amp;type=3#download_0&quot;); top: 395px; left: 161px;"/>
